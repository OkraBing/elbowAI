{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elbow.badbot.com.cn/a2ui/elbow-catalog/v1.json",
  "title": "elbowAI 组件目录 v1（A2UI v0.9 自定义目录）",
  "description": "Agent 生成追问卡片时只能用这里的组件。每个输入组件必须带 need（信息需求编号）并把 value 绑定到 /answers/<need>。按钮的 action.event.name 只有 submit_answers（提交）和 skip（跳过，context.needs 列出跳过的项）。功能卡片（上传资料、诊断建议、就诊摘要、紧急提醒、等待医生确认）不在目录里，由服务端以固定块下发。",
  "$defs": {
    "ComponentId": {"type": "string", "minLength": 1, "maxLength": 32},
    "ChildList": {"type": "array", "items": {"$ref": "#/$defs/ComponentId"}, "maxItems": 12},
    "Binding": {"type": "object", "required": ["path"], "properties": {"path": {"type": "string", "pattern": "^/answers/[A-Za-z0-9_:]+$"}}, "additionalProperties": false},
    "Option": {"type": "object", "required": ["label", "value"], "properties": {"label": {"type": "string", "minLength": 1, "maxLength": 16}, "value": {}}, "additionalProperties": false},
    "InputBase": {"type": "object", "required": ["id", "component", "need", "value"], "properties": {
      "id": {"$ref": "#/$defs/ComponentId"}, "need": {"type": "string"}, "value": {"$ref": "#/$defs/Binding"},
      "submitOnChange": {"type": "boolean", "description": "单项卡片：选了就提交，不显示「好了」按钮"}}}
  },
  "components": {
    "Column": {"type": "object", "required": ["id", "component", "children"], "properties": {"id": {"$ref": "#/$defs/ComponentId"}, "component": {"const": "Column"}, "children": {"$ref": "#/$defs/ChildList"}}},
    "Row": {"type": "object", "required": ["id", "component", "children"], "properties": {"id": {"$ref": "#/$defs/ComponentId"}, "component": {"const": "Row"}, "children": {"$ref": "#/$defs/ChildList"}}},
    "Text": {"type": "object", "required": ["id", "component", "text"], "properties": {"id": {"$ref": "#/$defs/ComponentId"}, "component": {"const": "Text"},
      "text": {"type": "string", "maxLength": 60}, "variant": {"enum": ["label", "body", "hint"]}}},
    "Divider": {"type": "object", "required": ["id", "component"], "properties": {"id": {"$ref": "#/$defs/ComponentId"}, "component": {"const": "Divider"}}},
    "Button": {"type": "object", "required": ["id", "component", "text", "action"], "properties": {"id": {"$ref": "#/$defs/ComponentId"}, "component": {"const": "Button"},
      "text": {"type": "string", "maxLength": 12}, "variant": {"enum": ["primary", "text"]},
      "checks": {"type": "array", "items": {"type": "object", "required": ["call", "message"], "properties": {"call": {"enum": ["anyAnswered", "required"]}, "args": {"type": "object"}, "message": {"type": "string"}}}},
      "action": {"type": "object", "required": ["event"], "properties": {"event": {"type": "object", "required": ["name"], "properties": {"name": {"enum": ["submit_answers", "skip"]}, "context": {"type": "object"}}}}}}},
    "ChoiceChips": {"allOf": [{"$ref": "#/$defs/InputBase"}, {"properties": {"component": {"const": "ChoiceChips"}, "variant": {"enum": ["single", "multiple"]},
      "options": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"$ref": "#/$defs/Option"}}, "wrap": {"type": "boolean"}, "hint": {"type": "string", "maxLength": 30},
      "noneOption": {"description": "多选里的「都没有」类选项（选它会清掉其他）"}}, "required": ["options"]}]},
    "YesNo": {"allOf": [{"$ref": "#/$defs/InputBase"}, {"properties": {"component": {"const": "YesNo"}, "labels": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "string", "maxLength": 8}},
      "options": {"type": "array", "items": {"$ref": "#/$defs/Option"}}}}]},
    "PainScale": {"allOf": [{"$ref": "#/$defs/InputBase"}, {"properties": {"component": {"const": "PainScale"}, "ends": {"type": "array", "items": {"type": "string"}}}}]},
    "BodySiteMap": {"allOf": [{"$ref": "#/$defs/InputBase"}, {"properties": {"component": {"const": "BodySiteMap"}, "side": {"enum": ["左", "右", "双侧", null]},
      "options": {"type": "array", "items": {"$ref": "#/$defs/Option"}, "description": "可点的区域（外侧、内侧、前方/肘窝、后方/肘尖、弥漫），可以只给一部分"}}}]},
    "TimeAgo": {"allOf": [{"$ref": "#/$defs/InputBase"}, {"properties": {"component": {"const": "TimeAgo"}, "options": {"type": "array", "items": {"$ref": "#/$defs/Option"}}}}]},
    "MeasureLauncher": {"allOf": [{"$ref": "#/$defs/InputBase"}, {"properties": {"component": {"const": "MeasureLauncher"}, "side": {"enum": ["左", "右", null]}},
      "description": "测角入口（功能卡片，内部结构由前端决定）。只能单独出现，配一个 skip 按钮"}]}
  },
  "rules": [
    "一张卡片最多 3 个输入组件；测角入口只能单独出现",
    "输入组件的 need 必须是这一轮服务端算出的待问需求，不能是已经知道的",
    "选项的 value 只能来自需求定义；Agent 可以删减、排序、改问法",
    "文字不含诊断、治疗建议和表情符号，不超过 60 字"
  ]
}
